# Copie este archivo a .env y ajuste los valores.
# Dominio público (Caddy obtiene el certificado HTTPS automáticamente). Vacío = HTTP en el puerto 80.
DOMAIN=
# Origen permitido para CORS si el frontend se publica en otro dominio (por ejemplo Vercel).
CORS_ORIGIN=*
# Ventana de agregación del fan-out público (ms)
WINDOW_MS=2000
# Habilita POST /api/debug/flood para la demostración de clientes lentos (RF-9). 0 en producción.
DEBUG_ENDPOINTS=1
