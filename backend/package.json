{
  "name": "sistemas-de-votacion-backend",
  "version": "1.0.0",
  "description": "Preconteo electoral en tiempo real: WebSocket + SSE + Redis (backplane, historial, bloqueos, presencia)",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
